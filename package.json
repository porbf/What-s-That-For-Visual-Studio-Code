{
  "name": "whats-that",
  "displayName": "What's That (WST)",
  "description": "为代码补全候选项与代码行添加来自 .WST 文件夹的中文说明注释。",
  "version": "0.1.0",
  "publisher": "wst",
  "license": "MIT",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Snippets",
    "Other"
  ],
  "keywords": [
    "注释",
    "补全",
    "snippet",
    "comment"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wst",
          "title": "What's That",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "wst": [
        {
          "type": "webview",
          "id": "wst.sidebar",
          "name": "WST 控制台"
        }
      ]
    },
    "commands": [
      {
        "command": "wst.refresh",
        "title": "WST: 刷新 .WST 数据"
      },
      {
        "command": "wst.toggleEnabled",
        "title": "WST: 启用 / 停用"
      }
    ],
    "configuration": {
      "title": "What's That (WST)",
      "properties": {
        "wst.enabled": {
          "type": "boolean",
          "default": true,
          "description": "总开关：是否启用 WST。"
        },
        "wst.enableCandidateComments": {
          "type": "boolean",
          "default": true,
          "description": "启用候选注释：在补全候选项右侧显示 .WST 中的文本注释。"
        },
        "wst.enableLineComments": {
          "type": "boolean",
          "default": true,
          "description": "启用代码行注释：在代码行右侧显示 .WST 中的文本注释。"
        }
      }
    }
  }
}

{
  "name": "whats-that",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.1.0",
  "publisher": "wst",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/porbf/What-s-That-For-Visual-Studio-Code"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Snippets",
    "Other"
  ],
  "keywords": [
    "comment",
    "annotation",
    "snippet",
    "documentation",
    "注释"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wst",
          "title": "%views.wst.title%",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "wst": [
        {
          "type": "webview",
          "id": "wst.sidebar",
          "name": "%views.wst.sidebar.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "wst.refresh",
        "title": "%command.wst.refresh%"
      },
      {
        "command": "wst.toggleEnabled",
        "title": "%command.wst.toggleEnabled%"
      }
    ],
    "configuration": {
      "title": "%config.title%",
      "properties": {
        "wst.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.wst.enabled%"
        },
        "wst.enableCandidateComments": {
          "type": "boolean",
          "default": true,
          "description": "%config.wst.enableCandidateComments%"
        },
        "wst.enableLineComments": {
          "type": "boolean",
          "default": true,
          "description": "%config.wst.enableLineComments%"
        }
      }
    }
  }
}
